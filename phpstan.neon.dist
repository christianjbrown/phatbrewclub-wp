includes:
    - vendor/christianjbrown/code-quality-scripts/config/phpstan.neon
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    tmpDir: .phpstan.cache
    paths:
        - src
    # wp-config.php and the mu-plugin loader run before any autoloader and are
    # procedural by necessity, so they are checked by `php -l` in CI rather than
    # here, where every WordPress global would need a stub.
    scanDirectories:
        - public/wp
    # Carbon Fields' carbon_get_post_meta and friends are global functions loaded
    # through Composer's `files` autoload, so PSR-4 discovery never sees them.
    scanFiles:
        - vendor/htmlburger/carbon-fields/config.php
        - vendor/htmlburger/carbon-fields/core/functions.php
